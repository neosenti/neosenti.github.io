---
import { content } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const a = content[lang].accessibility;
const email = content[lang].contact.email;
const subject = encodeURIComponent(lang === 'pt' ? 'Acessibilidade' : 'Accessibility');
---
<div class="wrap">
  <div class="page-head"><h1>{a.h1}</h1></div>
  <div class="prose">
    {a.sections.map((s, i) => (
      <section aria-labelledby={`h-a11y-${i}`}>
        <h2 id={`h-a11y-${i}`}>{s.h2}</h2>
        {s.paragraphs.map((p) => <p>{p}</p>)}
      </section>
    ))}
    <p><a class="btn btn--primary" href={`mailto:${email}?subject=${subject}`}>{a.reportCta}</a></p>
  </div>
</div>
